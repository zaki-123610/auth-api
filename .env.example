# Neon connection string (Neon dashboard > Connect). Keep TLS enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

PORT=3000

# Number of reverse proxies in front of the app (set to 1 on Render), 0 when running locally.
TRUST_PROXY=0
